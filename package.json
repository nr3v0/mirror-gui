{
  "name": "mirror-gui",
  "version": "1.0",
  "description": "Web application for OpenShift Container Platform mirroring operations using oc-mirror v2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openshift/mirror-gui.git"
  },
  "author": "Yakov Beder",
  "keywords": [
    "openshift",
    "oc-mirror",
    "mirroring",
    "operators",
    "disconnected"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "go run ./cmd/mirror-gui",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "audit:fetch-catalogs": "node scripts/audit-fetch-catalogs.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "clean": "rm -rf dist node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@patternfly/patternfly": "^6",
    "@patternfly/react-component-groups": "^6.4.0",
    "@patternfly/react-core": "^6",
    "@patternfly/react-icons": "^6",
    "@patternfly/react-table": "^6",
    "@patternfly/react-templates": "^6.4.3",
    "axios": "^1.18.0",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.2.5",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
